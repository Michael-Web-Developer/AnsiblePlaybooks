global
        log /dev/log    local0
        log /dev/log    local1 notice
        chroot /var/lib/haproxy
        stats socket /run/haproxy/admin.sock mode 660 level admin
        stats timeout 30s
        user haproxy
        group haproxy
        daemon

        # Default SSL material locations
        ca-base /etc/ssl/certs
        crt-base /etc/ssl/private

        # See: https://ssl-config.mozilla.org/#server=haproxy&server-version=2.0.3&config=intermediate
        ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
        ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
        ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
        log     global
        mode    tcp
        option  tcplog
        option  dontlognull
        timeout connect 10s
        timeout client  300s
        timeout server  300s
        timeout tunnel  1h
        retries 3
        errorfile 400 /etc/haproxy/errors/400.http
        errorfile 403 /etc/haproxy/errors/403.http
        errorfile 408 /etc/haproxy/errors/408.http
        errorfile 500 /etc/haproxy/errors/500.http
        errorfile 502 /etc/haproxy/errors/502.http
        errorfile 503 /etc/haproxy/errors/503.http
        errorfile 504 /etc/haproxy/errors/504.http

# Секция приема трафика
frontend main_frontend
    bind *:443
    mode tcp
    option tcplog

    # Извлекаем SNI из ClientHello (ждём до 5 секунд)
    tcp-request inspect-delay 5s
    tcp-request content set-var(sess.sni) req.ssl_sni if { req_ssl_hello_type 1 }
    tcp-request content accept if { req_ssl_hello_type 1 }

    # Логируем с SNI и временными метками
    log-format "%ci:%cp [%t] %ft %b/%s %Tw/%Tc/%Tt %B %ts %ac/%fc/%bc/%sc/%rc sni=%[var(sess.sni)]"

    # XHTTP: TLS терминируется на HAProxy (см. frontend xhttp_https)
    use_backend xhttp_tls      if { req.ssl_sni -i ru-nl.x.limita-net.ru ru-us.x.limita-net.ru }
    use_backend NL_Proxy       if { req.ssl_sni -i vk.ru }
    use_backend NL_Proxy_Test  if { req.ssl_sni -i runl.x.limita-net.ru }
    use_backend US_Proxy       if { req.ssl_sni -i www.jsdelivr.com }
    use_backend FN_Proxy       if { req.ssl_sni -i app.limita-net.ru }
    use_backend DE_Proxy       if { req.ssl_sni -i cloud.vk.com }
    default_backend US_Proxy

# Секция распределения трафика
backend US_Proxy
    mode tcp

    # Health checks: проверяем, жив ли сервер, каждые 2 секунды
    server us-proxy 127.0.0.1:10300 check inter 10s send-proxy-v2

backend NL_Proxy
    mode tcp

    # Health checks: проверяем, жив ли сервер, каждые 2 секунды
    server nl-proxy 127.0.0.1:10301 check inter 10s send-proxy-v2

backend NL_Proxy_Test
    mode tcp

    # Health checks: проверяем, жив ли сервер, каждые 2 секунды
    server nl-proxy 127.0.0.1:10305 check inter 10s send-proxy-v2

backend FN_Proxy
    mode tcp

    # Health checks: проверяем, жив ли сервер, каждые 2 секунды
    server fn-proxy 127.0.0.1:10302 check inter 10s send-proxy-v2

backend DE_Proxy
    mode tcp
    server de-proxy 127.0.0.1:10303 check inter 10s send-proxy-v2

backend xhttp_tls
    mode tcp
    server termination abns@xhttp send-proxy-v2

frontend xhttp_https
    bind abns@xhttp accept-proxy ssl crt /etc/haproxy/certs/wildcard-x.limita-net.ru.pem alpn h2,http/1.1
    bind 127.0.0.1:8443 accept-proxy ssl crt /etc/haproxy/certs/wildcard-x.limita-net.ru.pem alpn h2,http/1.1
    mode http
    option httplog
    option forwardfor
    http-request capture req.hdr(X-Forwarded-For) len 64
    http-request capture req.hdr(Host) len 64
    http-request capture req.hdr(Referer) len 128
    http-request capture req.hdr(X-Media-Session) len 128
    log-format "%ci %hr %HM %HP%HQ -> be=%b srv=%s status=%ST Tr=%Tr bytes=%B"
    timeout http-request 30s
    timeout http-keep-alive 15s
    timeout client 120s
    use_backend xhttp_nl if { ssl_fc_sni -i ru-nl.x.limita-net.ru } { path_beg /v1/media/segments/ }
    use_backend xhttp_us if { ssl_fc_sni -i ru-us.x.limita-net.ru } { path_beg /v1/media/segments/ }
    default_backend landing

backend xhttp_nl
    mode http
    option http-keep-alive
    http-reuse always
    server nl 127.0.0.1:2002 check

backend xhttp_us
    mode http
    option http-keep-alive
    http-reuse always
    server us 127.0.0.1:2003 check

backend landing
    mode http
    http-request return status 200 content-type text/html string "<!doctype html><title>Media</title>"

# Добавь это для отчета по лабе — статистика в реальном времени
listen stats
    bind *:9000
    mode http
    stats enable
    stats uri /stats-5495
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
